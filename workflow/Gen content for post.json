    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json;\nconst normalizedData = $(\"Normalize Data\").first().json;\n\nlet parsedContent;\ntry {\n  const textContent = aiOutput.content?.parts?.[0]?.text || \"\";\n  parsedContent = JSON.parse(textContent);\n} catch (e) {\n  parsedContent = { post: { content: \"\", hashtags: \"\", closing: \"\", galleries: [] }, comments: [] };\n}\n\nreturn [\n  {\n    json: {\n      post: {\n        content: parsedContent.post?.content || \"\",\n        hashtags: parsedContent.post?.hashtags || \"\",\n        closing: parsedContent.post?.closing || \"\",\n        galleries: (parsedContent.post?.galleries && parsedContent.post.galleries.length > 0) ? parsedContent.post.galleries : normalizedData.gallery\n      },\n      comments: parsedContent.comments   || [],\n      productInfo: {\n        name: normalizedData.name,\n        price: normalizedData.price,\n        brand: normalizedData.brand,\n        rating: normalizedData.rating,\n        priceLevel: normalizedData.priceLevel,\n        affLink: normalizedData.affLink,\n        type: normalizedData.type,\n        description: normalizedData.description\n      }\n    }\n  }\n];"
      },
