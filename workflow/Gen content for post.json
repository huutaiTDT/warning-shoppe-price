    {
      "parameters": {
        "jsCode": "const p = $input.first().json.product || {};\n\nfunction formatPrice(price) {\n  if (!price) return \"\";\n  return price.toLocaleString(\"vi-VN\") + \"đ\";\n}\n\nlet priceLevel = \"tầm trung\";\nif (p.price < 1000000) priceLevel = \"giá rẻ\";\nelse if (p.price > 5000000) priceLevel = \"cao cấp\";\n\nreturn [\n  {\n    json: {\n      affLink: $input.first().json.affLink,\n      type: Number($input.first().json.type),\n      name: p.name || \"\",\n      price: formatPrice(p.price),\n      brand: p.brand || \"\",\n      rating: p.rating || 0,\n      priceLevel,\n      gallery: p.gallery || [],\n      description: p.description\n    }\n  }\n];"
      },
