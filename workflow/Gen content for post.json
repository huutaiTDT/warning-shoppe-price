    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst prompt = \"Bạn là content creator affiliate tại Việt Nam.\\n\\nTrả về DUY NHẤT JSON hợp lệ, không markdown.\\n\\nSchema:\\n{\\n  \\\"post\\\": {\\n    \\\"content\\\": \\\"string\\\",\\n    \\\"hashtags\\\": \\\"string\\\",\\n    \\\"closing\\\": \\\"string\\\",\\n    \\\"galleries\\\": []\\n  },\\n  \\\"comments\\\": [\\\"string\\\", \\\"string\\\"]\\n}\\n\\nQuy tắc chung:\\n- Comment phải chứa link\\n- Văn phong tự nhiên, gần gũi\\n\\nQuy tắc cho Threads:\\n- Nội dung ngắn gọn, súc tích (100-200 từ)\\n- Hashtag tối đa 3-5 cái\\n- Tập trung vào insight, trải nghiệm cá nhân\\n\\nDữ liệu sản phẩm:\\nTên: \" + data.name + \"\\nGiá: \" + data.price + \"\\nBrand: \" + data.brand + \"\\nRating: \" + data.rating + \"\\nPhân khúc: \" + data.priceLevel + \"\\nLink: \" + data.affLink;\n\nreturn [{ json: { prompt, ...data } }];"
      },
