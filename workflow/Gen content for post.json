      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst prompt = \"Bạn là content creator affiliate tại Việt Nam.\\n\\nTrả về DUY NHẤT JSON hợp lệ, không markdown.\\n\\nSchema:\\n{\\n  \\\"post\\\": {\\n    \\\"content\\\": \\\"string\\\",\\n    \\\"hashtags\\\": \\\"string\\\",\\n    \\\"closing\\\": \\\"string\\\",\\n    \\\"galleries\\\": []\\n  },\\n  \\\"comments\\\": [\\\"string\\\", \\\"string\\\"]\\n}\\n\\nQuy tắc chung:\\n- Comment phải chứa link\\n- Văn phong tự nhiên, gần gũi\\n\\nQuy tắc cho Facebook:\\n- Nội dung chi tiết, đầy đủ thông tin (200-400 từ)\\n- Hashtag 5-10 cái\\n- Có thể dùng emoji, chia đoạn rõ ràng\\n- Tạo sự tương tác, hỏi ý kiến người đọc\\n\\nDữ liệu sản phẩm:\\nTên: \" + data.name + \"\\nGiá: \" + data.price + \"\\nBrand: \" + data.brand + \"\\nRating: \" + data.rating + \"\\nPhân khúc: \" + data.priceLevel + \"\\nLink: \" + data.affLink;\n\nreturn [{ json: { prompt, ...data } }];"
